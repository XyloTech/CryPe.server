# ==========================================
# CryPe Backend Configuration
# ==========================================

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ==========================================
# PostgreSQL Database
# ==========================================
# Install: https://www.postgresql.org/download/
# Data directory: typically /var/lib/postgresql/data/ or %APPDATA%/postgresql/
#
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crpe
POSTGRES_USER=crpe
POSTGRES_PASSWORD=password

# ==========================================
# Redis Cache
# ==========================================
# Install: https://redis.io/download/
# Window service: redis-server --daemonize yes
# Or WSL: redis-server --daemonize yes
#
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# Blockchain Nodes (Optional)
# ==========================================
# For real-time event monitoring (WebSocket recommended)
# INFURA_PROJECT_ID=
# ALCHEMY_PROJECT_ID=

# ==========================================
# Security
# ==========================================
# JWT Secret for session tokens (generate: openssl rand -hex 32)
# JWT_EXPIRES_IN=24h